# Binaries
/asyncgo
/asyncgo.exe
*.exe
*.test
*.out

# Go workspace (go.work is committed; go.work.sum is regenerated)
go.work.sum

# Generated harness temp dirs (normally auto-removed; the leading underscore
# keeps them out of the go tool's `./...` package patterns)
_asyncgo-harness-*/

# Vendor (managed via `go mod vendor`)
vendor/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Serena (don't version cache)
.serena/cache/

# ASDF
.tool-versions

# MkDocs site build output and the local build virtualenv (see site/)
site/build/
site/.venv/

# The Project section is assembled from docs/ at build time (site/hooks/assemble.py)
site/content/project/adr/
site/content/project/designdoc/
site/content/project/asyncapi-3.1.0-coverage.md

# Python bytecode from the site build hook
__pycache__/
*.pyc

# local agent scratch
.tmp/

# Pi Lens
.pi-lens.json
